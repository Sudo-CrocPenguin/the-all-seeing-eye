APP_NAME="The All Seeing Eye"
APP_ENV=production
DATABASE_URL=postgresql+psycopg://audit:change_me@postgres:5432/the_all_seeing_eye
PERSISTENCE_BACKEND=sqlalchemy
API_DOCS_ENABLED=false
HEALTH_REQUIRE_CURRENT_MIGRATION=true
TRUSTED_PROXY_IPS=127.0.0.1/32
AGENT_HEARTBEAT_TIMEOUT_SECONDS=180
MISSED_HEARTBEAT_SCHEDULER_ENABLED=true
MISSED_HEARTBEAT_SCHEDULER_INTERVAL_SECONDS=60

AGENT_TOKEN_HEADER=X-Agent-Token
AUDITOR_TOKEN=change_me_32_chars_minimum_auditor_token
AUDITOR_TOKEN_HEADER=X-Auditor-Token
AUDITOR_SESSION_HEADER=X-Auditor-Session
PROVISIONING_TOKEN=change_me_32_chars_minimum_provisioning
PROVISIONING_TOKEN_HEADER=X-Provisioning-Token

OTP_DELIVERY_PROVIDER=twilio
OTP_DELIVERY_TIMEOUT_SECONDS=10
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=change_me_32_chars_minimum_twilio_secret
TWILIO_FROM_PHONE_NUMBER=+15551111111
OTP_RATE_LIMIT_WINDOW_SECONDS=600
OTP_RATE_LIMIT_MAX_PER_COMPANY=5
OTP_RATE_LIMIT_MAX_PER_DEVICE=3
OTP_RATE_LIMIT_MAX_PER_IP=20
